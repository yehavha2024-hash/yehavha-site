# YEHAVHA NEXUS deployment cache policy
# HTML and UI code must revalidate so structural fixes appear immediately.

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/news/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

/*.css
  Cache-Control: no-cache, must-revalidate

/*.js
  Cache-Control: no-cache, must-revalidate
