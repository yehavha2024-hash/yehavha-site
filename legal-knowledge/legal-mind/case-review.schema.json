{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yehavha-nexus-hub.pages.dev/legal-knowledge/legal-mind/case-review.schema.json",
  "title": "Legal Mind Case Review Record",
  "description": "리걸 마인드 사례를 역할분담 사건검토 파이프라인에서 사용하는 사건 단위 정규화 기록 스키마",
  "type": "object",
  "required": ["schemaVersion", "pipelineVersion", "caseId", "metadata", "intake", "law", "evidence", "arguments", "analysis", "decision", "review", "audit"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0"},
    "pipelineVersion": {"type": "string", "const": "1.0"},
    "caseId": {"type": "string", "minLength": 1},
    "metadata": {
      "type": "object",
      "required": ["title", "mode", "area", "level", "question"],
      "properties": {
        "title": {"type": "string"},
        "mode": {"type": "string"},
        "area": {"type": "string"},
        "level": {"type": "string"},
        "question": {"type": "string"},
        "summary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "intake": {
      "type": "object",
      "required": ["facts", "legalFacts", "relations", "issues"],
      "properties": {
        "facts": {"$ref": "#/$defs/nodes"},
        "legalFacts": {"$ref": "#/$defs/nodes"},
        "relations": {"$ref": "#/$defs/nodes"},
        "issues": {"$ref": "#/$defs/nodes"}
      },
      "additionalProperties": false
    },
    "law": {
      "type": "object",
      "required": ["laws", "precedents", "officialSources"],
      "properties": {
        "laws": {"$ref": "#/$defs/nodes"},
        "precedents": {"$ref": "#/$defs/nodes"},
        "officialSources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "url"],
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "verificationStatus": {"type": "string", "enum": ["linked", "manual-check-required", "verified"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["items", "burdens"],
      "properties": {
        "items": {"$ref": "#/$defs/nodes"},
        "burdens": {"$ref": "#/$defs/nodes"}
      },
      "additionalProperties": false
    },
    "arguments": {
      "type": "object",
      "required": ["claimant", "respondent"],
      "properties": {
        "claimant": {"$ref": "#/$defs/nodes"},
        "respondent": {"$ref": "#/$defs/nodes"}
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "required": ["subsumption", "procedure"],
      "properties": {
        "subsumption": {"$ref": "#/$defs/nodes"},
        "procedure": {"$ref": "#/$defs/nodes"}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["conclusions", "variations"],
      "properties": {
        "conclusions": {"$ref": "#/$defs/nodes"},
        "variations": {"$ref": "#/$defs/nodes"}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "stages", "gates"],
      "properties": {
        "status": {"type": "string", "enum": ["ready", "running", "completed", "manual-review-required"]},
        "stages": {
          "type": "object",
          "required": ["collector", "analyst", "counter", "verifier", "neutralPanel", "integrator"],
          "properties": {
            "collector": {"$ref": "#/$defs/stage"},
            "analyst": {"$ref": "#/$defs/stage"},
            "counter": {"$ref": "#/$defs/stage"},
            "verifier": {"$ref": "#/$defs/stage"},
            "neutralPanel": {"$ref": "#/$defs/stage"},
            "integrator": {"$ref": "#/$defs/stage"}
          },
          "additionalProperties": false
        },
        "gates": {
          "type": "object",
          "required": ["sourceGate", "counterArgumentGate", "neutralityGate"],
          "properties": {
            "sourceGate": {"type": "string"},
            "counterArgumentGate": {"type": "string"},
            "neutralityGate": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["generatedAt", "sourceCaseId", "manualReviewRequired"],
      "properties": {
        "generatedAt": {"type": "string", "format": "date-time"},
        "sourceCaseId": {"type": "string"},
        "manualReviewRequired": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string"},
        "refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "stage": {
      "type": "object",
      "required": ["role", "status", "outputs"],
      "properties": {
        "role": {"type": "string"},
        "status": {"type": "string", "enum": ["waiting", "completed", "conditional", "manual-review-required"]},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "sourceRefs": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
